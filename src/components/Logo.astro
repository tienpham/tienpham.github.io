---
import { SITE } from "@/config";
---

<a href="/" class="logo-link group" aria-label={`${SITE.title} - Home`}>
  <span class="logo-container">
    <!-- Ensō circle with neural nodes -->
    <svg
      class="logo-icon"
      viewBox="0 0 40 40"
      fill="none"
      aria-hidden="true"
    >
      <!-- Outer ensō (zen circle) with gap -->
      <circle
        class="enso-stroke"
        cx="20"
        cy="20"
        r="16"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-dasharray="85 15"
        fill="none"
      />

      <!-- Inner neural network pattern -->
      <g class="neural-nodes">
        <!-- Center node -->
        <circle cx="20" cy="20" r="2.5" fill="currentColor" class="node-center" />

        <!-- Orbital nodes -->
        <circle cx="20" cy="11" r="1.5" fill="currentColor" class="node node-1" />
        <circle cx="27" cy="16" r="1.5" fill="currentColor" class="node node-2" />
        <circle cx="27" cy="24" r="1.5" fill="currentColor" class="node node-3" />
        <circle cx="20" cy="29" r="1.5" fill="currentColor" class="node node-4" />
        <circle cx="13" cy="24" r="1.5" fill="currentColor" class="node node-5" />
        <circle cx="13" cy="16" r="1.5" fill="currentColor" class="node node-6" />

        <!-- Connection lines from center -->
        <g class="connections" stroke="currentColor" stroke-width="0.75" opacity="0.4">
          <line x1="20" y1="20" x2="20" y2="11" class="conn conn-1" />
          <line x1="20" y1="20" x2="27" y2="16" class="conn conn-2" />
          <line x1="20" y1="20" x2="27" y2="24" class="conn conn-3" />
          <line x1="20" y1="20" x2="20" y2="29" class="conn conn-4" />
          <line x1="20" y1="20" x2="13" y2="24" class="conn conn-5" />
          <line x1="20" y1="20" x2="13" y2="16" class="conn conn-6" />
        </g>
      </g>
    </svg>

    <!-- Text with letter-by-letter styling -->
    <span class="logo-text">
      <span class="text-main">
        <span class="letter letter-1">R</span><span class="letter letter-2">e</span><span class="letter letter-3">f</span><span class="letter letter-4">l</span><span class="letter letter-5">e</span><span class="letter letter-6">x</span><span class="letter letter-7">i</span><span class="letter letter-8">f</span><span class="letter letter-9">y</span>
      </span>
      <span class="text-glow" aria-hidden="true">{SITE.title}</span>
      <span class="text-underline" aria-hidden="true"></span>
    </span>
  </span>
</a>

<style>
  .logo-link {
    display: inline-flex;
    text-decoration: none;
    color: inherit;
    outline-offset: 4px;
  }

  .logo-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Logo icon */
  .logo-icon {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-accent);
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .logo-link:hover .logo-icon {
    transform: rotate(360deg);
  }

  /* Ensō circle animation */
  .enso-stroke {
    transform-origin: center;
    transition: stroke-dasharray 0.4s ease;
  }

  .logo-link:hover .enso-stroke {
    stroke-dasharray: 100 0;
    animation: enso-breathe 2s ease-in-out infinite;
  }

  @keyframes enso-breathe {
    0%, 100% {
      stroke-dasharray: 100 0;
    }
    50% {
      stroke-dasharray: 90 10;
    }
  }

  /* Neural nodes */
  .node-center {
    transition: r 0.3s ease;
  }

  .logo-link:hover .node-center {
    r: 3;
  }

  .node {
    opacity: 0.6;
    transition: opacity 0.3s ease, r 0.3s ease;
  }

  .logo-link:hover .node {
    opacity: 1;
    animation: node-pulse 1.5s ease-in-out infinite;
  }

  .logo-link:hover .node-1 { animation-delay: 0s; }
  .logo-link:hover .node-2 { animation-delay: 0.1s; }
  .logo-link:hover .node-3 { animation-delay: 0.2s; }
  .logo-link:hover .node-4 { animation-delay: 0.3s; }
  .logo-link:hover .node-5 { animation-delay: 0.4s; }
  .logo-link:hover .node-6 { animation-delay: 0.5s; }

  @keyframes node-pulse {
    0%, 100% {
      opacity: 0.6;
      r: 1.5;
    }
    50% {
      opacity: 1;
      r: 2;
    }
  }

  /* Connection lines */
  .conn {
    stroke-dasharray: 12;
    stroke-dashoffset: 12;
    transition: stroke-dashoffset 0.4s ease, opacity 0.3s ease;
  }

  .logo-link:hover .conn {
    stroke-dashoffset: 0;
    opacity: 0.7;
  }

  .logo-link:hover .conn-1 { transition-delay: 0s; }
  .logo-link:hover .conn-2 { transition-delay: 0.05s; }
  .logo-link:hover .conn-3 { transition-delay: 0.1s; }
  .logo-link:hover .conn-4 { transition-delay: 0.15s; }
  .logo-link:hover .conn-5 { transition-delay: 0.2s; }
  .logo-link:hover .conn-6 { transition-delay: 0.25s; }

  /* Logo text */
  .logo-text {
    position: relative;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  @media (min-width: 640px) {
    .logo-text {
      font-size: 1.5rem;
    }
  }

  .text-main {
    position: relative;
    z-index: 1;
    display: inline-flex;
  }

  /* Individual letter styling */
  .letter {
    display: inline-block;
    color: var(--color-foreground);
    transition:
      color 0.3s ease,
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      text-shadow 0.3s ease;
  }

  /* Staggered hover effect for letters */
  .logo-link:hover .letter {
    color: var(--color-accent);
    animation: letter-wave 0.6s ease forwards;
  }

  .logo-link:hover .letter-1 { animation-delay: 0s; }
  .logo-link:hover .letter-2 { animation-delay: 0.03s; }
  .logo-link:hover .letter-3 { animation-delay: 0.06s; }
  .logo-link:hover .letter-4 { animation-delay: 0.09s; }
  .logo-link:hover .letter-5 { animation-delay: 0.12s; }
  .logo-link:hover .letter-6 { animation-delay: 0.15s; }
  .logo-link:hover .letter-7 { animation-delay: 0.18s; }
  .logo-link:hover .letter-8 { animation-delay: 0.21s; }
  .logo-link:hover .letter-9 { animation-delay: 0.24s; }

  @keyframes letter-wave {
    0% {
      transform: translateY(0);
      color: var(--color-foreground);
    }
    40% {
      transform: translateY(-3px);
    }
    100% {
      transform: translateY(0);
      color: var(--color-accent);
    }
  }

  /* Special styling for key letters */
  .letter-1 {
    font-weight: 700;
  }

  /* The 'x' gets special treatment - AI crossroads symbol */
  .letter-6 {
    position: relative;
  }

  .logo-link:hover .letter-6 {
    text-shadow:
      0 0 8px var(--color-accent),
      0 0 16px var(--color-accent);
  }

  /* Underline effect */
  .text-underline {
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-accent) 20%,
      var(--color-accent) 80%,
      transparent 100%
    );
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.6;
  }

  .logo-link:hover .text-underline {
    transform: scaleX(1);
  }

  /* Glow effect behind text */
  .text-glow {
    position: absolute;
    inset: 0;
    color: var(--color-accent);
    filter: blur(10px);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .logo-link:hover .text-glow {
    opacity: 0.35;
    animation: glow-pulse 2s ease-in-out infinite;
  }

  @keyframes glow-pulse {
    0%, 100% {
      opacity: 0.35;
      filter: blur(10px);
    }
    50% {
      opacity: 0.5;
      filter: blur(14px);
    }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .logo-icon,
    .enso-stroke,
    .node,
    .node-center,
    .conn,
    .letter,
    .text-underline,
    .text-glow {
      transition: none;
      animation: none;
    }

    .logo-link:hover .logo-icon {
      transform: none;
    }

    .logo-link:hover .conn {
      stroke-dashoffset: 0;
    }

    .logo-link:hover .letter {
      color: var(--color-accent);
      animation: none;
    }

    .logo-link:hover .text-underline {
      transform: scaleX(1);
    }

    .logo-link:hover .text-glow {
      opacity: 0.35;
      animation: none;
    }
  }
</style>
